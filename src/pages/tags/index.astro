---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countValues, getPosts } from '../../lib/blog';

const tags = countValues(await getPosts(), 'tags');
---

<BaseLayout title="标签">
  <section class="page-shell narrow">
    <div class="page-heading"><h1>标签</h1><p>{tags.length} 个</p></div>
    <div class="cloud">
      {tags.map(([tag, count]) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag} <small>{count}</small></a>)}
    </div>
  </section>
</BaseLayout>
