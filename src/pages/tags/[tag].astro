---
import type { Post } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { countValues, getPosts } from '../../lib/blog';

interface Props { tag: string; posts: Post[] }
export async function getStaticPaths() {
  const posts = await getPosts();
  return countValues(posts, 'tags').map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <section class="page-shell shell">
    <div class="page-heading"><h1>#{tag}</h1><p>{posts.length} 篇文章</p></div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
