---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import SumiChrome from "@/components/SumiChrome.astro";
import PostLayout from "@/layouts/PostLayout.astro";
import config from "@/config";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return getSortedPosts(posts).map(post => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await render(post);
const locale = Astro.currentLocale ?? config.site.lang;
const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  categories,
} = post.data;

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: post.data.timezone ?? config.site.timezone,
});
const homePath = getRelativeLocaleUrl(locale, "");
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  {description}
  {ogImage}
  {canonicalURL}
  {pubDatetime}
  {modDatetime}
>
  <main class="sumi-article-shell" id="main-content" data-pagefind-body>
    <a class="sumi-back" href={homePath}>← 返回文章列表</a>

    <article>
      <header class="sumi-article-header">
        <h1>{title}</h1>
        <p class="sumi-article-meta">
          <time datetime={pubDatetime.toISOString()}
            >{dateFormatter.format(pubDatetime).replaceAll("/", "-")}</time
          >
          {
            categories.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <span>{categories.join(" / ")}</span>
              </>
            )
          }
        </p>
      </header>

      <div class="sumi-article-content app-prose">
        <Content />
      </div>
    </article>
  </main>

  <SumiChrome />

  <script>
    import mermaid from "mermaid";

    let renderSequence = 0;

    async function renderMermaid() {
      const blocks = [
        ...document.querySelectorAll<HTMLElement>(
          '.sumi-article-content pre[data-language="mermaid"]'
        ),
      ];

      blocks.forEach(block => {
        const container = document.createElement("div");
        container.className = "sumi-mermaid";
        container.dataset.source = block.textContent ?? "";
        block.replaceWith(container);
      });

      const diagrams = [
        ...document.querySelectorAll<HTMLElement>(".sumi-mermaid[data-source]"),
      ];
      if (diagrams.length === 0) return;

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme:
          document.documentElement.dataset.theme === "dark"
            ? "dark"
            : "neutral",
      });

      const sequence = ++renderSequence;
      for (const [index, container] of diagrams.entries()) {
        const source = container.dataset.source ?? "";
        try {
          const { svg, bindFunctions } = await mermaid.render(
            `sumi-mermaid-${sequence}-${index}`,
            source
          );
          container.innerHTML = svg;
          container.classList.remove("sumi-mermaid-error");
          bindFunctions?.(container);
        } catch {
          container.textContent = source;
          container.classList.add("sumi-mermaid-error");
        }
      }
    }

    function bindCopyButtons() {
      const blocks = document.querySelectorAll<HTMLElement>(
        ".sumi-article-content pre:not([data-language='mermaid'])"
      );

      blocks.forEach(block => {
        if (block.dataset.copyBound === "true") return;
        block.dataset.copyBound = "true";
        block.tabIndex = 0;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "sumi-copy-code";
        button.textContent = "复制";
        button.setAttribute("aria-label", "复制代码");
        button.addEventListener("click", async () => {
          const code = block.querySelector("code")?.textContent ?? "";
          await navigator.clipboard.writeText(code);
          button.textContent = "已复制";
          window.setTimeout(() => (button.textContent = "复制"), 900);
        });
        block.appendChild(button);
      });
    }

    function initArticleEnhancements() {
      void renderMermaid();
      bindCopyButtons();
    }

    initArticleEnhancements();
    document.addEventListener("astro:page-load", initArticleEnhancements);
    window.addEventListener("theme-change", () => void renderMermaid());
  </script>
</PostLayout>
