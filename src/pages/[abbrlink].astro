---
import { render } from 'astro:content';
import type { Post } from '../lib/blog';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPosts, postUrl, readingTime } from '../lib/blog';

interface Props { post: Post }

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { abbrlink: post.data.abbrlink },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const current = posts.findIndex((item) => item.id === post.id);
const newer = current > 0 ? posts[current - 1] : undefined;
const older = current < posts.length - 1 ? posts[current + 1] : undefined;
const excerpt = post.data.description ?? (post.body ?? '').replace(/```[\s\S]*?```|<[^>]+>|[#>*_`\[\]()-]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 150);
---

<BaseLayout title={post.data.title} description={excerpt} type="article">
  <article>
    <header class="article-header narrow">
      <p class="eyebrow">{post.data.categories.join(' · ')}</p>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post)} 分钟阅读</span>
        {post.data.updated && post.data.updated.valueOf() !== post.data.date.valueOf() && <span>更新于 {formatDate(post.data.updated)}</span>}
      </div>
      <div class="post-taxonomy">
        {post.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
      </div>
    </header>
    {headings.length > 2 && (
      <details class="narrow article-toc">
        <summary>本文目录</summary>
        <ol>
          {headings.filter(({ depth }) => depth <= 3).map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </details>
    )}
    <div class="prose narrow"><Content /></div>
    <nav class="narrow article-nav" aria-label="相邻文章">
      {older ? <a href={postUrl(older)}>← {older.data.title}</a> : <span />}
      {newer && <a href={postUrl(newer)}>{newer.data.title} →</a>}
    </nav>
  </article>
</BaseLayout>
