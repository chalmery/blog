---
import type { Post } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { countValues, getPosts } from '../../lib/blog';

interface Props { category: string; posts: Post[] }
export async function getStaticPaths() {
  const posts = await getPosts();
  return countValues(posts, 'categories').map(([category]) => ({
    params: { category },
    props: { category, posts: posts.filter((post) => post.data.categories.includes(category)) },
  }));
}
const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`}>
  <section class="page-shell shell">
    <div class="page-heading"><h1>{category}</h1><p>{posts.length} 篇文章</p></div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
