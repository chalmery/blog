---
import type { Post } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts } from '../../lib/blog';

interface Props {
  posts: Post[];
  currentPage: number;
  lastPage: number;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  const pageSize = 10;
  const lastPage = Math.ceil(posts.length / pageSize);
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice((currentPage - 1) * pageSize, currentPage * pageSize),
        currentPage,
        lastPage,
      },
    };
  });
}

const { posts, currentPage, lastPage } = Astro.props;
---

<BaseLayout title={`第 ${currentPage} 页`}>
  <section class="page-shell shell">
    <div class="page-heading">
      <h1>所有文章</h1>
      <p>第 {currentPage} 页</p>
    </div>
    <PostList posts={posts} />
    <Pagination currentPage={currentPage} lastPage={lastPage} />
  </section>
</BaseLayout>
