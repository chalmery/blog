---
import type { Post } from '../lib/blog';
import { formatDate, postUrl, readingTime } from '../lib/blog';

interface Props { post: Post }
const { post } = Astro.props;
const excerpt = post.data.description ?? (post.body ?? '')
  .replace(/```[\s\S]*?```|<[^>]+>|[#>*_`\[\]()-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 150);
---

<li class="post-card">
  <a class="post-card-title" href={postUrl(post)}>{post.data.title}</a>
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>·</span>
    <span>{readingTime(post)} 分钟阅读</span>
  </div>
  <p class="post-excerpt">{excerpt}{excerpt.length >= 150 ? '…' : ''}</p>
</li>
